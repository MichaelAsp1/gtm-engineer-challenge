# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# The provided Corti Models API key is sent out-of-band. Put it here.

# Corti Models API key (required for LLM calls)
CORTI_API_KEY=

# Mock CRM server host/port (Node reads these via process.env)
CRM_PORT=3001
CRM_HOST=localhost
